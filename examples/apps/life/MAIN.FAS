# Life - Conway's Game of Life. Space pauses, R reseeds, G drops a glider gun, Esc leaves.
fn rgb(r, g, b) { ret r * 65536 + g * 256 + b }
bg = rgb(12, 15, 19)
alive = rgb(61, 200, 220)
young = rgb(150, 240, 200)
white = rgb(242, 245, 247)
muted = rgb(154, 167, 176)

w = fb_width()
h = fb_height()
cell = 10
cols = floor((w - 80) / cell)
rows = floor((h - 140) / cell)
ox = floor((w - cols * cell) / 2)
oy = 100
n = cols * rows
none = 0 - 1

a = []
nb = []
age = []
i = 0
while i < n {
    push(a, 0)
    push(nb, 0)
    push(age, 0)
    i = i + 1
}

fn seed(a, age, n) {
    i = 0
    while i < n {
        a[i] = 0
        if randbelow(100) < 22 { a[i] = 1 }
        age[i] = 0
        i = i + 1
    }
}

fn gun(a, age, n, cols) {
    i = 0
    while i < n {
        a[i] = 0
        age[i] = 0
        i = i + 1
    }
    pts = [5,1, 5,2, 6,1, 6,2, 5,11, 6,11, 7,11, 4,12, 8,12, 3,13, 9,13, 3,14, 9,14, 6,15,
           4,16, 8,16, 5,17, 6,17, 7,17, 6,18, 3,21, 4,21, 5,21, 3,22, 4,22, 5,22, 2,23, 6,23,
           1,25, 2,25, 6,25, 7,25, 3,35, 4,35, 3,36, 4,36]
    j = 0
    while j < len(pts) {
        a[(pts[j] + 4) * cols + pts[j + 1] + 4] = 1
        j = j + 2
    }
}

seed(a, age, n)
gen = 0
paused = false
running = true
while running {
    k = poll_key()
    while k != none {
        if k == 27 or k == 113 { running = false }
        if k == 32 { paused = not paused }
        if k == 114 or k == 82 {
            seed(a, age, n)
            gen = 0
        }
        if k == 103 or k == 71 {
            gun(a, age, n, cols)
            gen = 0
        }
        k = poll_key()
    }
    if poll_click() == 1 { running = false }

    if not paused {
        # count neighbours (the board wraps at the edges)
        y = 0
        while y < rows {
            up = ((y + rows - 1) % rows) * cols
            mid = y * cols
            dn = ((y + 1) % rows) * cols
            x = 0
            while x < cols {
                l = (x + cols - 1) % cols
                r = (x + 1) % cols
                nb[mid + x] = a[up + l] + a[up + x] + a[up + r] + a[mid + l] + a[mid + r] + a[dn + l] + a[dn + x] + a[dn + r]
                x = x + 1
            }
            y = y + 1
        }
        pop_n = 0
        i = 0
        while i < n {
            c = nb[i]
            if a[i] == 1 {
                if c < 2 or c > 3 {
                    a[i] = 0
                    age[i] = 0
                } else { age[i] = age[i] + 1 }
            } else {
                if c == 3 {
                    a[i] = 1
                    age[i] = 0
                }
            }
            pop_n = pop_n + a[i]
            i = i + 1
        }
        gen = gen + 1
    }

    fb_clear(bg)
    i = 0
    while i < n {
        if a[i] == 1 {
            c = alive
            if age[i] < 2 { c = young }
            fb_rect(ox + (i % cols) * cell, oy + floor(i / cols) * cell, cell - 1, cell - 1, c)
        }
        i = i + 1
    }
    fb_text(ox, 40, "LIFE", alive, bg)
    fb_text(ox, 64, "Generation " + str(gen), white, bg)
    fb_text(ox + cols * cell - 400, 64, "Space pause  R reseed  G glider gun  Esc quit", muted, bg)
    fb_present()
    sleep_ms(30)
}
