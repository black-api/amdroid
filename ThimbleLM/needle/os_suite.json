       "maximum": 100
      }
     },
     "required": [
      "level"
     ]
    }
   },
   {
    "name": "do_not_disturb",
    "description": "Turn Do Not Disturb on or off. On silences notifications.",
    "parameters": {
     "type": "object",
     "properties": {
      "action": {
       "type": "string",
       "enum": [
        "on",
        "off"
       ],
       "description": "on or off."
      }
     },
     "required": [
      "action"
     ]
    }
   },
   {
    "name": "add_note",
