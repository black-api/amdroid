{
 "am_droid": {
  "tools": [
   {
    "name": "open_app",
    "description": "Open an app on the desktop.",
    "parameters": {
     "type": "object",
     "properties": {
      "app": {
       "type": "string",
       "enum": [
        "files",
        "notes",
        "browser",
        "calculator",
        "clock",
        "settings",
        "tasks",
        "app store",
        "network",
        "video player",
        "about",
        "terminal"
       ],
       "description": "The app to open."
      }
     },
     "required": [
      "app"
     ]
    }
   },
   {
    "name": "close_app",
    "description": "Close an app's window. With no app named, close the window in front.",
    "parameters": {
     "type": "object",
     "properties": {
      "app": {
       "type": "string",
       "enum": [
        "files",
        "notes",
        "browser",
        "calculator",
        "clock",
        "settings",
        "tasks",
        "app store",
        "network",
        "video player",
        "about",
        "terminal"
       ],
       "description": "The app to close; include only when the user names one."
      }
     }
    }
   },
   {
    "name": "search_web",
    "description": "Search the web or open a website in the browser.",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "The search words or web address, copied word for word.",
       "minLength": 1,
       "maxLength": 100
      }
     },
     "required": [
      "query"
     ]
    }
   },
   {
    "name": "open_website",
    "description": "Open a website in the browser by its address, like example.com.",
    "parameters": {
     "type": "object",
     "properties": {
      "address": {
       "type": "string",
       "description": "The web address, copied word for word.",
       "minLength": 3,
       "maxLength": 100
      }
     },
     "required": [
      "address"
     ]
    }
   },
   {
    "name": "set_volume",
    "description": "Set the sound volume.",
    "parameters": {
     "type": "object",
     "properties": {
      "level": {
       "type": "integer",
       "description": "Volume from 0 to 100.",
       "minimum": 0,
       "maximum": 100
      }
     },
     "required": [
      "level"
     ]
    }
   },
   {
    "name": "set_brightness",
